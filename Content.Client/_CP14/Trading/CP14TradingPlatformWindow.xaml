<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:g="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               Title="{Loc 'cp14-catalogue-title'}" MinSize="650 400" SetSize="840 555">
    <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="7">
        <PanelContainer>
            <PanelContainer.PanelOverride>
                <g:StyleBoxFlat BackgroundColor="#243b36" />
            </PanelContainer.PanelOverride>
            <BoxContainer Margin="12 5" SeparationOverride="10">
                <TextureRect Name="WalletArt"
                             SetSize="38 38" Stretch="KeepAspectCentered" />
                <Label Text="{Loc 'cp14-catalogue-stock'}" StyleClasses="LabelHeadingBigger"
                       FontColorOverride="#f2deb4" HorizontalExpand="True" />
                <Label Text="{Loc 'cp14-catalogue-funds'}" FontColorOverride="#c7d8ca" />
                <BoxContainer Name="FundsHolder" VerticalAlignment="Center" />
            </BoxContainer>
        </PanelContainer>
        <BoxContainer SeparationOverride="7">
            <LineEdit Name="Search" PlaceHolder="{Loc 'cp14-catalogue-search'}" HorizontalExpand="True" />
            <Button Name="ClearSearch" Text="{Loc 'cp14-catalogue-clear'}" Disabled="True" />
            <OptionButton Name="Suppliers" MinWidth="155" MaxWidth="240" />
            <CheckBox Name="AvailableOnly" Text="{Loc 'cp14-catalogue-available'}" />
        </BoxContainer>
        <BoxContainer VerticalExpand="True" SeparationOverride="9">
            <PanelContainer HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <g:StyleBoxFlat BackgroundColor="#1b2426" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" Margin="5" SeparationOverride="4">
                    <Label Name="Results" StyleClasses="LabelSubText" Margin="5 1" FontColorOverride="#c8c5b7" />
                    <RichTextLabel Name="NoResults" Margin="6 8" Visible="False" />
                    <ScrollContainer Name="StockScroll" HScrollEnabled="False" VerticalExpand="True">
                        <BoxContainer Name="Stock" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="3" />
                    </ScrollContainer>
                </BoxContainer>
            </PanelContainer>
            <PanelContainer SetWidth="240">
                <PanelContainer.PanelOverride>
                    <g:StyleBoxFlat BackgroundColor="#303331" />
                </PanelContainer.PanelOverride>
                <BoxContainer Name="Details" Orientation="Vertical" Margin="12" SeparationOverride="6" Visible="False">
                    <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                            <PanelContainer MinHeight="86">
                                <PanelContainer.PanelOverride>
                                    <g:StyleBoxFlat BackgroundColor="#222b29" />
                                </PanelContainer.PanelOverride>
                                <TextureRect Name="ItemArt" SetSize="72 72" HorizontalAlignment="Center"
                                             VerticalAlignment="Center" Stretch="KeepAspectCentered" TextureScale="2 2" />
                            </PanelContainer>
                            <RichTextLabel Name="ItemName" StyleClasses="LabelHeadingBigger" />
                            <RichTextLabel Name="ItemSupplier" />
                            <RichTextLabel Name="ItemDescription" Margin="0 3" />
                            <RichTextLabel Name="Reputation" StyleClasses="LabelSubText" />
                        </BoxContainer>
                    </ScrollContainer>
                    <PanelContainer StyleClasses="LowDivider" MinHeight="1" />
                    <BoxContainer>
                        <Label Text="{Loc 'cp14-catalogue-price'}" HorizontalExpand="True" />
                        <BoxContainer Name="PriceHolder" />
                    </BoxContainer>
                    <RichTextLabel Name="BuyStatus" />
                    <Button Name="BuyButton" Text="{Loc 'cp14-trading-ui-button-buy'}" MinHeight="34"
                            StyleClasses="ButtonColorGreen" Disabled="True" />
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
        <Label Text="{Loc 'cp14-catalogue-payment'}" FontColorOverride="#c6c4b6" StyleClasses="LabelSubText" />
    </BoxContainer>
</DefaultWindow>
